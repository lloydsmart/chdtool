#!/usr/bin/env bash
# Minimal stub to satisfy your script in CI

case "$1" in
  --help|-help)
    echo "chdman 0.000 (stub) - createdvd createcd verify"; exit 0
    ;;
  verify)
    # your script greps for "complete" and optionally "(ratio=..%)"
    echo "Verifying, 100% complete (ratio=50%)" >&2
    exit 0
    ;;
  createcd|createdvd)
    input=""
    output=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -i) input="$2"; shift 2 ;;
        -o) output="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    if [[ -n "${CHDMAN_FAIL_INPUT:-}" && "$input" == *"$CHDMAN_FAIL_INPUT"* ]]; then
      echo "stub chdman: requested failure for $input" >&2
      exit 2
    fi
    : > "$output"
    echo "Compressing, 100% complete (ratio=50%)" >&2
    exit 0
    ;;
  *)
    echo "stub chdman: unknown args: $*" >&2
    exit 1
    ;;
esac
